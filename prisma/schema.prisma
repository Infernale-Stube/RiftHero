generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Summoner {
  id             String    @id @default(cuid())
  puuid          String    @unique
  gameName       String
  tagLine        String
  region         String    // UI Region: euw, eune, na, kr
  platform       String    // Platform ID: euw1, eun1, na1, kr
  profileIconId  Int       @default(29)
  summonerLevel  BigInt    @default(1)
  revisionDate   BigInt?
  lastFetchedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Ranked Solo / Duo
  soloTier       String?   // IRON, BRONZE, SILVER, GOLD, PLATINUM, EMERALD, DIAMOND, MASTER, GRANDMASTER, CHALLENGER
  soloRank       String?   // I, II, III, IV
  soloLp         Int       @default(0)
  soloWins       Int       @default(0)
  soloLosses     Int       @default(0)

  // Ranked Flex
  flexTier       String?
  flexRank       String?
  flexLp         Int       @default(0)
  flexWins       Int       @default(0)
  flexLosses     Int       @default(0)

  // Ranked 5s / Premade 5s
  ranked5sTier   String?
  ranked5sRank   String?
  ranked5sLp     Int       @default(0)
  ranked5sWins   Int       @default(0)
  ranked5sLosses Int       @default(0)

  lpSnapshots    SummonerLpSnapshot[]
  participants   MatchParticipant[]

  @@index([gameName, tagLine])
  @@index([region, gameName, tagLine])
  @@index([lastFetchedAt(sort: Desc)])
  @@index([soloTier, soloLp])
  @@map("summoners")
}

model SummonerLpSnapshot {
  id           String   @id @default(cuid())
  summonerId   String
  queueType    String   // RANKED_SOLO_5x5, RANKED_FLEX_SR
  tier         String   // IRON, BRONZE, SILVER, GOLD, PLATINUM, EMERALD, DIAMOND, MASTER, GRANDMASTER, CHALLENGER
  rank         String   // I, II, III, IV
  leaguePoints Int      @default(0)
  totalLp      Int      @default(0) // Continuous ladder point: Iron IV 0LP = 0, Silver IV = 800, etc.
  wins         Int      @default(0)
  losses       Int      @default(0)
  delta        Int?     // LP delta since previous snapshot (+24, -19)
  recordedAt   DateTime @default(now())

  summoner     Summoner @relation(fields: [summonerId], references: [id], onDelete: Cascade)

  @@index([summonerId, queueType, recordedAt(sort: Desc)])
  @@map("summoner_lp_snapshots")
}

model Match {
  id                  String   @id // e.g. EUW1_6999999999
  gameCreation        BigInt
  gameDuration        Int      // seconds
  gameEndTimestamp    BigInt?
  gameMode            String   // CLASSIC, ARAM, etc.
  gameType            String   // MATCHED_GAME
  gameVersion         String
  mapId               Int
  queueId             Int      // 420: Solo, 440: Flex, 450: ARAM, 400: Normal Draft
  endOfGameResult     String?
  createdAt           DateTime @default(now())

  // Team 100 (Blue) Bans (Champion IDs)
  blueBan1            Int?
  blueBan2            Int?
  blueBan3            Int?
  blueBan4            Int?
  blueBan5            Int?

  // Team 200 (Red) Bans (Champion IDs)
  redBan1             Int?
  redBan2             Int?
  redBan3             Int?
  redBan4             Int?
  redBan5             Int?

  // Team 100 (Blue) Objectives
  blueTowerKills      Int      @default(0)
  blueInhibitorKills  Int      @default(0)
  blueBaronKills      Int      @default(0)
  blueDragonKills     Int      @default(0)
  blueRiftHeraldKills Int      @default(0)
  blueHordeKills      Int      @default(0)
  blueFirstTower      Boolean  @default(false)
  blueFirstInhibitor  Boolean  @default(false)
  blueFirstBaron      Boolean  @default(false)
  blueFirstDragon     Boolean  @default(false)
  blueFirstHorde      Boolean  @default(false)
  blueFirstRiftHerald Boolean  @default(false)

  // Team 200 (Red) Objectives
  redTowerKills       Int      @default(0)
  redInhibitorKills   Int      @default(0)
  redBaronKills       Int      @default(0)
  redDragonKills      Int      @default(0)
  redRiftHeraldKills  Int      @default(0)
  redHordeKills       Int      @default(0)
  redFirstTower       Boolean  @default(false)
  redFirstInhibitor   Boolean  @default(false)
  redFirstBaron       Boolean  @default(false)
  redFirstDragon      Boolean  @default(false)
  redFirstHorde       Boolean  @default(false)
  redFirstRiftHerald  Boolean  @default(false)

  participants        MatchParticipant[]

  @@index([gameCreation(sort: Desc)])
  @@index([queueId])
  @@map("matches")
}

model MatchParticipant {
  id                             String    @id @default(cuid())
  matchId                        String
  puuid                          String
  summonerId                     String?   // Relation to registered summoner if exists
  riotIdGameName                 String
  riotIdTagline                  String
  championId                     Int
  championName                   String
  champLevel                     Int       @default(1)
  teamId                         Int       // 100: Blue, 200: Red
  win                            Boolean
  role                           String?
  lane                           String?
  teamPosition                   String?   // TOP, JUNGLE, MIDDLE, BOTTOM, UTILITY
  profileIcon                    Int?      @default(29)

  // Combat Stats
  kills                          Int       @default(0)
  deaths                         Int       @default(0)
  assists                        Int       @default(0)
  kda                            Float?    @default(0.0)
  totalDamageDealtToChampions    Int       @default(0)
  physicalDamageDealtToChampions Int?      @default(0)
  magicDamageDealtToChampions    Int?      @default(0)
  trueDamageDealtToChampions     Int?      @default(0)
  totalDamageTaken               Int       @default(0)
  totalHeal                      Int?      @default(0)
  totalMinionsKilled             Int       @default(0)
  neutralMinionsKilled           Int       @default(0)
  visionScore                    Int       @default(0)
  visionWardsBoughtInGame        Int       @default(0)
  wardsPlaced                    Int       @default(0)
  wardsKilled                    Int       @default(0)
  goldEarned                     Int       @default(0)
  goldSpent                      Int       @default(0)

  // Items (0-5 Inventory, 6 Trinket)
  item0                          Int       @default(0)
  item1                          Int       @default(0)
  item2                          Int       @default(0)
  item3                          Int       @default(0)
  item4                          Int       @default(0)
  item5                          Int       @default(0)
  item6                          Int       @default(0)

  // Summoner Spells (D, F)
  summoner1Id                    Int       @default(0)
  summoner2Id                    Int       @default(0)

  // Runes / Perks
  primaryRune                    Int?      // Primary Keystone perk ID
  primaryStyle                   Int?      // Primary Path style ID
  secondaryStyle                 Int?      // Secondary Sub-style ID
  perksJson                      Json?     // Full rune breakdown for deep-dive analysis

  // Prepared for Timeline Deep-Dives, Heatmaps & Tier Lists
  challengesJson                 Json?     // Granular stats, skillshot hit %, multikills
  timelineSummaryJson            Json?     // Gold @ 15, CS diff @ 15, kill participation

  match                          Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  summoner                       Summoner? @relation(fields: [summonerId], references: [id], onDelete: SetNull)

  @@unique([matchId, puuid])
  @@index([puuid])
  @@index([championId])
  @@index([championName])
  @@index([win])
  @@index([summonerId])
  @@map("match_participants")
}

model ChampionSnapshot {
  id                  String   @id // 'current', 'previous', or 'active'
  version             String
  patch               String
  championsCount      Int      @default(0)
  championsJson       Json
  championDetailsJson Json?
  computedAt          DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("champion_snapshots")
}

model MetaSnapshot {
  id                String   @id // 'current' or 'previous'
  patch             String
  version           String
  totalMatches      Int      @default(0)
  metaPicksJson     Json
  tierListJson      Json
  championStatsJson Json?
  computedAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("meta_snapshots")
}

model ItemSnapshot {
  id              String   @id @default("active")
  version         String
  patch           String
  itemsCount      Int      @default(0)
  itemsJson       Json
  itemDetailsJson Json?
  treeJson        Json?
  computedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("item_snapshots")
}

