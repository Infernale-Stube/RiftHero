generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Summoner {
  id             String    @id @default(cuid())
  puuid          String    @unique
  gameName       String
  tagLine        String
  region         String    // UI Region: euw, eune, na, kr
  platform       String    // Platform ID: euw1, eun1, na1, kr
  summonerId     String?   // Encrypted summoner ID
  accountId      String?   // Encrypted account ID
  profileIconId  Int       @default(29)
  summonerLevel  BigInt    @default(1)
  revisionDate   BigInt?
  lastFetchedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  ranks          SummonerRank[]
  lpSnapshots    SummonerLpSnapshot[]
  participants   MatchParticipant[]

  @@index([gameName, tagLine])
  @@index([region, gameName, tagLine])
  @@index([lastFetchedAt(sort: Desc)])
  @@map("summoners")
}

model SummonerRank {
  id           String   @id @default(cuid())
  summonerId   String
  queueType    String   // RANKED_SOLO_5x5, RANKED_FLEX_SR
  tier         String   // IRON, BRONZE, SILVER, GOLD, PLATINUM, EMERALD, DIAMOND, MASTER, GRANDMASTER, CHALLENGER
  rank         String   // I, II, III, IV
  leaguePoints Int      @default(0)
  wins         Int      @default(0)
  losses       Int      @default(0)
  veteran      Boolean  @default(false)
  inactive     Boolean  @default(false)
  freshBlood   Boolean  @default(false)
  hotStreak    Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  summoner     Summoner @relation(fields: [summonerId], references: [id], onDelete: Cascade)

  @@unique([summonerId, queueType])
  @@index([tier, leaguePoints])
  @@map("summoner_ranks")
}

model SummonerLpSnapshot {
  id           String   @id @default(cuid())
  summonerId   String
  queueType    String   // RANKED_SOLO_5x5, RANKED_FLEX_SR
  tier         String   // IRON, BRONZE, SILVER, GOLD, PLATINUM, EMERALD, DIAMOND, MASTER, GRANDMASTER, CHALLENGER
  rank         String   // I, II, III, IV
  leaguePoints Int      @default(0)
  totalLp      Int      @default(0) // Continuous ladder point: Iron IV 0LP = 0, Silver IV = 800, etc.
  wins         Int      @default(0)
  losses       Int      @default(0)
  delta        Int?     // LP delta since previous snapshot (+24, -19)
  recordedAt   DateTime @default(now())

  summoner     Summoner @relation(fields: [summonerId], references: [id], onDelete: Cascade)

  @@index([summonerId, queueType, recordedAt(sort: Desc)])
  @@map("summoner_lp_snapshots")
}

model Match {
  id               String   @id // e.g. EUW1_6999999999
  cluster          String   // europe, americas, asia
  dataVersion      String   @default("2")
  gameCreation     BigInt
  gameDuration     Int      // seconds
  gameEndTimestamp BigInt?
  gameId           BigInt
  gameMode         String   // CLASSIC, ARAM, etc.
  gameType         String   // MATCHED_GAME
  gameVersion      String
  mapId            Int
  queueId          Int      // 420: Solo, 440: Flex, 450: ARAM, 400: Normal Draft
  tournamentCode   String?
  endOfGameResult  String?
  teamsJson        Json?    // Full team objectives (Drakes, Barons, Towers, Grubs, Bans)
  timelineJson     Json?    // Timeline frames for gold diff graphs & objective timeline
  createdAt        DateTime @default(now())

  participants     MatchParticipant[]

  @@index([gameCreation(sort: Desc)])
  @@index([queueId])
  @@map("matches")
}

model MatchParticipant {
  id                             String    @id @default(cuid())
  matchId                        String
  puuid                          String
  summonerId                     String?   // Relation to registered summoner if exists
  riotIdGameName                 String
  riotIdTagline                  String
  championId                     Int
  championName                   String
  champLevel                     Int       @default(1)
  teamId                         Int       // 100: Blue, 200: Red
  win                            Boolean
  role                           String?
  lane                           String?
  teamPosition                   String?   // TOP, JUNGLE, MIDDLE, BOTTOM, UTILITY
  profileIcon                    Int?      @default(29)

  // Combat Stats
  kills                          Int       @default(0)
  deaths                         Int       @default(0)
  assists                        Int       @default(0)
  kda                            Float?    @default(0.0)
  totalDamageDealtToChampions    Int       @default(0)
  physicalDamageDealtToChampions Int?      @default(0)
  magicDamageDealtToChampions    Int?      @default(0)
  trueDamageDealtToChampions     Int?      @default(0)
  totalDamageTaken               Int       @default(0)
  totalHeal                      Int?      @default(0)
  totalMinionsKilled             Int       @default(0)
  neutralMinionsKilled           Int       @default(0)
  visionScore                    Int       @default(0)
  visionWardsBoughtInGame        Int       @default(0)
  wardsPlaced                    Int       @default(0)
  wardsKilled                    Int       @default(0)
  goldEarned                     Int       @default(0)
  goldSpent                      Int       @default(0)

  // Items (0-5 Inventory, 6 Trinket)
  item0                          Int       @default(0)
  item1                          Int       @default(0)
  item2                          Int       @default(0)
  item3                          Int       @default(0)
  item4                          Int       @default(0)
  item5                          Int       @default(0)
  item6                          Int       @default(0)

  // Summoner Spells (D, F)
  summoner1Id                    Int       @default(0)
  summoner2Id                    Int       @default(0)

  // Runes / Perks
  primaryRune                    Int?      // Primary Keystone perk ID
  primaryStyle                   Int?      // Primary Path style ID
  secondaryStyle                 Int?      // Secondary Sub-style ID
  perksJson                      Json?     // Full rune breakdown for deep-dive analysis

  // Prepared for Timeline Deep-Dives, Heatmaps & Tier Lists
  challengesJson                 Json?     // Granular stats, skillshot hit %, multikills
  timelineSummaryJson            Json?     // Gold @ 15, CS diff @ 15, kill participation

  match                          Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  summoner                       Summoner? @relation(fields: [summonerId], references: [id], onDelete: SetNull)

  @@unique([matchId, puuid])
  @@index([puuid])
  @@index([championId])
  @@index([championName])
  @@index([win])
  @@index([summonerId])
  @@map("match_participants")
}

model MetaSnapshot {
  id                  String   @id @default("active")
  patch               String
  totalMatches        Int      @default(0)
  metaPicksJson       Json
  tierListJson        Json
  championsJson       Json?
  championDetailsJson Json?
  computedAt          DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("meta_snapshots")
}

model ItemSnapshot {
  id              String   @id @default("active")
  version         String
  patch           String
  itemsCount      Int      @default(0)
  itemsJson       Json
  itemDetailsJson Json?
  treeJson        Json?
  computedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("item_snapshots")
}

