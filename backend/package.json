{
  "name": "rifthero-backend",
  "version": "1.0.0",
  "description": "RiftHero Core REST API & Riot API Rate-Limited BullMQ Worker",
  "main": "dist/api/server.js",
  "scripts": {
    "build": "tsc",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=./prisma/schema.prisma",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/worker/index.js",
    "start:worker:high": "node dist/worker/highWorker.js",
    "start:worker:low": "node dist/worker/lowWorker.js",
    "start:worker:champions": "node dist/worker/championWorker.js",
    "start:worker:meta": "node dist/worker/metaWorkerRunner.js",
    "start:worker:counterpicks": "node dist/worker/counterPickWorker.js",
    "start:worker:maintenance": "node dist/worker/maintenanceWorker.js",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "db:clear:champions": "tsx scripts/clear-champions.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fightmegg/riot-api": "^0.0.21",
    "@fightmegg/riot-rate-limiter": "^0.0.23",
    "@prisma/client": "^5.22.0",
    "bottleneck": "^2.19.5",
    "bullmq": "^5.21.2",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
