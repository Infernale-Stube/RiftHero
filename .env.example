# ==============================================================================
# RiftHero Environment Configuration
# ==============================================================================

# Application Environment (prod | staging | dev)
APP_ENV=prod
NODE_ENV=production

# Domain Configuration (Used by Caddy for automated Let's Encrypt SSL/TLS certificates)
APP_DOMAIN=rifthero.gg
API_DOMAIN=api.rifthero.gg
ACME_EMAIL=admin@rifthero.gg

# Public URLs
PUBLIC_APP_URL=https://rifthero.gg
PUBLIC_API_URL=https://api.rifthero.gg
NEXT_PUBLIC_API_URL=/api

# Network Binding & Ports
BIND_IP=127.0.0.1
PORT=4000
FRONTEND_PORT=3000
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ==============================================================================
# Riot Games API Configuration (Production Key)
# ==============================================================================
# Your Riot Games Production API Key (starts with RGAPI-)
RIOT_API_KEY=RGAPI-00000000-0000-0000-0000-000000000000

# High-Capacity Production Rate Limits
# 1,000 requests every 10 seconds & 60,000 requests every 10 minutes
RATE_LIMIT_10S=1000
RATE_LIMIT_10M=60000

# Match Ingestion & 10-Player Snowball Crawler
INITIAL_MATCH_COUNT=50
ENABLE_SNOWBALL_CRAWLER=true
SNOWBALL_MATCH_DEPTH=20
SNOWBALL_MAX_CONCURRENCY=3

# Cache & Auto-refresh TTLs
PROFILE_STALE_MINUTES=2

# ==============================================================================
# PostgreSQL Database (PostgreSQL 16 Alpine)
# ==============================================================================
POSTGRES_USER=rifthero
POSTGRES_PASSWORD=rifthero_secret_2026
POSTGRES_DB=rifthero
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rifthero:rifthero_secret_2026@postgres:5432/rifthero?schema=public

# Auto-migrate schema on container startup (prisma db push)
AUTO_MIGRATE=true

# ==============================================================================
# Redis (BullMQ Queue & Worker Broker)
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ==============================================================================
# Production Mailserver (docker-mailserver)
# ==============================================================================
MAIL_LOG_LEVEL=info
POSTMASTER_ADDRESS=postmaster@rifthero.gg
SMTP_HOST=mailserver
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_IGNORE_TLS=false
MAIL_FROM=no-reply@rifthero.gg
ADMIN_ALERT_EMAIL=admin@rifthero.gg
MAIL_SSL_TYPE=manual

# Volume Names
DATA_VOLUME=rifthero-data
CADDY_DATA_VOLUME=rifthero-caddy-data
CADDY_CONFIG_VOLUME=rifthero-caddy-config
MAIL_DATA_VOLUME=rifthero-mail-data
MAIL_STATE_VOLUME=rifthero-mail-state
MAIL_LOGS_VOLUME=rifthero-mail-logs
