# ==============================================================================
# RiftHero Environment Configuration
# ==============================================================================

NODE_ENV=production
LOG_LEVEL=warn
CORS_ORIGIN=true

# Domain Configuration (Caddy HTTPS / TLS & Mailserver)
APP_DOMAIN=rifthero.lol
API_DOMAIN=api.rifthero.lol
ACME_EMAIL=admin@rifthero.lol

# Frontend API URLs
NEXT_PUBLIC_API_URL=/api
INTERNAL_API_URL=http://api:4000/api

# Network Binding & Ports
BIND_IP=127.0.0.1
PORT=4000
FRONTEND_PORT=3000
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ==============================================================================
# Riot Games API & Match Ingestion
# ==============================================================================
RIOT_API_KEY=RGAPI-00000000-0000-0000-0000-000000000000
RATE_LIMIT_10S=1000
RATE_LIMIT_10M=60000
INITIAL_MATCH_COUNT=50
ENABLE_SNOWBALL_CRAWLER=true
SNOWBALL_MATCH_DEPTH=20
SNOWBALL_MAX_CONCURRENCY=2
FETCH_ALL_SEASON_MATCHES=true
SEASON_START_EPOCH=0
MAX_SEASON_MATCHES=5000
PROFILE_STALE_MINUTES=1

# ==============================================================================
# Worker Schedules & Scraper Settings
# ==============================================================================
CHAMPION_SYNC_INTERVAL_MINUTES=60
META_WORKER_INTERVAL_HOURS=6
COUNTERPICK_INTERVAL_MINUTES=60
COUNTERPICK_CONCURRENCY=8
COUNTERPICK_FETCH_TIMEOUT_MS=15000

# ==============================================================================
# PostgreSQL Database
# ==============================================================================
POSTGRES_HOST=postgres
POSTGRES_USER=rifthero
POSTGRES_PASSWORD=rifthero_secret_2026
POSTGRES_DB=rifthero
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rifthero:rifthero_secret_2026@postgres:5432/rifthero?schema=public
AUTO_MIGRATE=true

# ==============================================================================
# Redis
# ==============================================================================
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ==============================================================================
# Maintenance & Backups
# ==============================================================================
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=7

# ==============================================================================
# Mailserver (docker-mailserver)
# ==============================================================================
MAIL_LOG_LEVEL=info
POSTMASTER_ADDRESS=postmaster@rifthero.lol
MAIL_SSL_TYPE=manual
